# The suite currently targets English labels and US-dollar prices.
BASE_URL=http://localhost:3001/us/en
HEADLESS=true
WAIT_TIMEOUT=30

# Set this to a product you created or seeded: stable price, USD, stock >= 2,
# no automatic discounts, and one seller. Do not depend on the first listing.
TEST_PRODUCT_SLUG=
# Optional ordered option labels, such as ["Red", "M"].
TEST_PRODUCT_OPTIONS=[]

# Optional absolute path for offline driver setup; otherwise Selenium manages it.
CHROMEDRIVER_PATH=

# Exact storefront name of the Stripe test-mode method, used only with --run-payments.
STRIPE_PAYMENT_METHOD=Credit Card

# Accounts are created per test with unique @example.com addresses.
# Fixed TEST_USER_EMAIL/TEST_USER_PASSWORD credentials are no longer required.
